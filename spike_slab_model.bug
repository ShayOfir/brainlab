
  model {
    for(i in 1:n) {
      Y1[i] ~ dt(mu1[i], tau_eps1, nu1)
      Y2[i] ~ dt(mu2[i], tau_eps2, nu2)
      mu1[i] <- inprod(X[i,], beta1[])
      mu2[i] <- inprod(X[i,], beta2[])
    }
    tau_eps1 ~ dgamma(tau_eps_0, tau_eps_0)
    tau_eps2 ~ dgamma(tau_eps_0, tau_eps_0)
    nu1      ~ dunif(nu1_a, nu1_b)
    nu2      ~ dunif(nu2_a, nu2_b)
    tau_beta1 ~ dgamma(tau_beta1_0, tau_beta1_0)
    tau_beta2 ~ dgamma(tau_beta2_0, tau_beta2_0)

    for(j in 1:p) {
      pi[j,1:4] ~ ddirch(alpha4[])
      z[j]      ~ dcat(pi[j,])
      theta1[j] ~ dnorm(0, tau_beta1)
      theta2[j] ~ dnorm(0, tau_beta2)
      beta1[j] <- equals(z[j],2)*theta1[j] +
                  equals(z[j],4)*theta1[j]
      beta2[j] <- equals(z[j],3)*theta2[j] +
                  equals(z[j],4)*theta2[j]
    }
  }
  
